{
  "aylis": 1,
  "root": {
    "class": "Form",
    "name": "fraHotkeyCard",
    "caption": "Configurações: cartão de atalho (modo, teclas e as opções do modo)",
    "width": 760,
    "height": 121,
    "align": "top",
    "auto_size": true,
    "fill": "transparent",
    "children": [
      {
        "class": "Panel",
        "name": "pnlCard",
        "height": 121,
        "align": "top",
        "padding": [12, 10],
        "auto_size": true,
        "style": "s_box",
        "children": [
          {
            "class": "Layout",
            "name": "lyKeys",
            "height": 32,
            "align": "top",
            "children": [
              {
                "class": "ComboBox",
                "name": "cmbMode",
                "arrow": "triangle",
                "width": 176,
                "align": "left",
                "margins": [0, 0, 10, 0]
              },
              {
                "class": "Panel",
                "name": "pnlCtrl",
                "width": 60,
                "align": "left",
                "margins": [0, 1.5, 6, 1.5],
                "style": "s_mod",
                "children": [
                  {
                    "class": "CheckBox",
                    "name": "chkCtrl",
                    "text": "Ctrl",
                    "box_size": 13,
                    "align": "client",
                    "margins": [11, 0, 6, 0],
                    "style": "mod"
                  }
                ]
              },
              {
                "class": "Panel",
                "name": "pnlShift",
                "width": 60,
                "align": "left",
                "margins": [0, 1.5, 6, 1.5],
                "style": "s_mod",
                "children": [
                  {
                    "class": "CheckBox",
                    "name": "chkShift",
                    "text": "Shift",
                    "box_size": 13,
                    "align": "client",
                    "margins": [11, 0, 6, 0],
                    "style": "mod"
                  }
                ]
              },
              {
                "class": "Panel",
                "name": "pnlAlt",
                "width": 60,
                "align": "left",
                "margins": [0, 1.5, 6, 1.5],
                "style": "s_mod",
                "children": [
                  {
                    "class": "CheckBox",
                    "name": "chkAlt",
                    "text": "Alt",
                    "box_size": 13,
                    "align": "client",
                    "margins": [11, 0, 6, 0],
                    "style": "mod"
                  }
                ]
              },
              {
                "class": "Panel",
                "name": "pnlWin",
                "width": 60,
                "align": "left",
                "margins": [0, 1.5, 6, 1.5],
                "style": "s_mod",
                "children": [
                  {
                    "class": "CheckBox",
                    "name": "chkWin",
                    "text": "Win",
                    "box_size": 13,
                    "align": "client",
                    "margins": [11, 0, 6, 0],
                    "style": "mod"
                  }
                ]
              },
              {
                "class": "Button",
                "name": "btnRemove",
                "text": "×",
                "width": 28,
                "height": 28,
                "align": "right",
                "margins": [10, 2, 0, 2],
                "style": "s_x",
                "font_size": 18,
                "hint": "Remover atalho"
              },
              {
                "class": "Label",
                "name": "lblPlus",
                "text": "+",
                "width": 10,
                "align": "left",
                "margins": [4, 0, 10, 0],
                "style": "s_plus"
              },
              {
                "class": "ComboBox",
                "name": "cmbKey",
                "arrow": "triangle",
                "align": "client"
              }
            ]
          },
          {
            "class": "Layout",
            "name": "lyWindow",
            "height": 32,
            "align": "top",
            "margins": [0, 10, 0, 0],
            "visible": false,
            "children": [
              {
                "class": "Label",
                "name": "lblWindowTitle",
                "text": "Título da janela contém",
                "width": 150,
                "align": "left",
                "style": "s_name2"
              },
              {
                "class": "Edit",
                "name": "edtWindowTitle",
                "placeholder": "ex.: nova guia",
                "width": 360,
                "align": "left"
              }
            ]
          },
          {
            "class": "Layout",
            "name": "lyAppAudio",
            "height": 17,
            "align": "top",
            "margins": [0, 10, 0, 0],
            "visible": false,
            "children": [
              {
                "class": "CheckBox",
                "name": "chkAppAudio",
                "text": "Gravar o som do app",
                "box_size": 16,
                "align": "client",
                "style": "web"
              }
            ]
          },
          {
            "class": "Layout",
            "name": "lyShot",
            "height": 32,
            "align": "top",
            "margins": [0, 10, 0, 0],
            "visible": false,
            "children": [
              {
                "class": "Label",
                "name": "lblShotTarget",
                "text": "O que capturar",
                "width": 140,
                "align": "left",
                "margins": [0, 0, 10, 0],
                "style": "s_name2"
              },
              {
                "class": "ComboBox",
                "name": "cmbShotTarget",
                "arrow": "triangle",
                "width": 280,
                "align": "left"
              }
            ]
          },
          {
            "class": "Layout",
            "name": "lyShotLast",
            "left": 8,
            "top": 8,
            "height": 17,
            "align": "top",
            "margins": [0, 10, 0, 0],
            "visible": false,
            "children": [
              {
                "class": "CheckBox",
                "name": "chkShotLast",
                "text": "Abrir com a última área capturada já selecionada",
                "box_size": 16,
                "left": 8,
                "top": 8,
                "align": "client",
                "style": "web"
              }
            ]
          },
          {
            "class": "Layout",
            "name": "lyArea",
            "height": 35,
            "align": "top",
            "margins": [0, 10, 0, 0],
            "visible": false,
            "children": [
              {
                "class": "Button",
                "name": "btnAreaClear",
                "text": "Escolher na hora",
                "width": 120,
                "height": 33,
                "align": "right",
                "margins": [8, 0, 0, 0],
                "style": "s"
              },
              {
                "class": "Button",
                "name": "btnAreaDefine",
                "text": "Definir área",
                "width": 100,
                "height": 33,
                "align": "right",
                "margins": [8, 0, 0, 0],
                "style": "s"
              },
              {
                "class": "Label",
                "name": "lblArea",
                "text": "Sem área salva — o atalho abre a seleção para você desenhar",
                "align": "client",
                "style": "s_inline3"
              }
            ]
          },
          {
            "class": "Layout",
            "name": "lyTimelapse",
            "height": 17,
            "align": "top",
            "margins": [0, 10, 0, 0],
            "visible": false,
            "children": [
              {
                "class": "CheckBox",
                "name": "chkTimelapse",
                "text": "Timelapse: grava só quando a área muda (o tempo parado é cortado)",
                "box_size": 16,
                "align": "client",
                "style": "web"
              }
            ]
          },
          {
            "class": "Layout",
            "name": "lyShotInfo",
            "align": "top",
            "margins": [0, 10, 0, 0],
            "visible": false,
            "auto_size": true,
            "children": [
              {
                "class": "Label",
                "name": "lblShotInfo",
                "text": "O print vai como PNG para a pasta de gravações e também para a área de transferência.",
                "v_align": "leading",
                "wrap": true,
                "align": "top",
                "auto_size": true,
                "style": "s_hint"
              }
            ]
          },
          {
            "class": "Layout",
            "name": "lyDelay",
            "height": 32,
            "align": "top",
            "margins": [0, 10, 0, 0],
            "children": [
              {
                "class": "Label",
                "name": "lblDelay",
                "text": "Atraso antes de começar",
                "width": 140,
                "align": "left",
                "margins": [0, 0, 10, 0],
                "style": "s_name2"
              },
              {
                "class": "ComboBox",
                "name": "cmbDelay",
                "arrow": "triangle",
                "align": "left"
              }
            ]
          },
          {
            "class": "Layout",
            "name": "lyStatus",
            "height": 16,
            "align": "top",
            "margins": [0, 10, 0, 0],
            "visible": false,
            "children": [
              {
                "class": "Label",
                "name": "lblStatus",
                "align": "client",
                "style": "s_hint"
              }
            ]
          }
        ]
      }
    ]
  }
}
