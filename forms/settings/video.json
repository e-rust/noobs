{
  "aylis": 1,
  "root": {
    "class": "Form",
    "name": "fraVideo",
    "caption": "Configurações: Vídeo",
    "width": 1410,
    "height": 851,
    "padding": [18, 24, 632, 14],
    "children": [
      { "class": "Label", "name": "lblCodec", "style": "s_label", "align": "top", "auto_size": true, "wrap": true, "v_align": "leading", "margins": [0, 0, 0, 0], "text": "Codec de vídeo" },
      { "class": "Layout", "name": "lyCodec", "align": "top", "height": 32, "children": [ { "class": "Image", "name": "imgGpu", "fit": "contain", "align": "right", "width": 32, "margins": [8, 0, 0, 0], "visible": false }, { "class": "ComboBox", "name": "cmbCodec", "arrow": "triangle", "align": "client", "on_change": "video_codec" } ] },
      { "class": "Label", "name": "lblCodecMaxRes", "style": "s_hint", "align": "top", "auto_size": true, "wrap": true, "v_align": "leading", "margins": [0, 6, 0, 0], "text": "Resolução máxima do codec: {{w}} × {{h}}" },
      { "class": "Layout", "name": "lylblCodecSwWarn", "align": "top", "auto_size": true, "margins": [0, 6, 0, 0], "children": [
          { "class": "Rectangle", "name": "barlblCodecSwWarn", "align": "most_left", "width": 2, "fill": "amber", "stroke_width": 0, "hit_test": false },
          { "class": "Label", "name": "lblCodecSwWarn", "style": "s_warn", "align": "top", "auto_size": true, "wrap": true, "v_align": "leading", "margins": [10, 0, 0, 0], "text": "Codifica na CPU e usa todos os núcleos. Acima de 1080p pode não acompanhar a gravação e perder quadros. Prefira um codificador de hardware se a sua placa tiver um." }
        ] },
      { "class": "Label", "name": "lblCodecHint", "style": "s_hint", "align": "top", "auto_size": true, "wrap": true, "v_align": "leading", "margins": [0, 6, 0, 0], "text": "Automático escolhe a melhor opção disponível na ordem H.264 hardware → H.264 software → AV1 hardware → HEVC hardware. Use uma escolha manual só se souber o que está fazendo." },
      { "class": "Rectangle", "name": "lnRule1", "style": "sep", "align": "top", "height": 1, "margins": [0, 10, 0, 0] },
      { "class": "Label", "name": "lblQuality", "style": "s_label", "align": "top", "auto_size": true, "wrap": true, "v_align": "leading", "margins": [0, 10, 0, 0], "text": "Qualidade da gravação" },
      { "class": "Layout", "name": "lyQuality", "align": "top", "height": 32, "margins": [0, 10, 0, 0], "children": [
          { "class": "Label", "name": "lblQualityLow", "style": "s_end", "align": "left", "width": 70, "margins": [0, 0, 10, 0], "text": "Menor" },
          { "class": "Label", "name": "lblQualityHigh", "style": "s_end", "align": "right", "width": 70, "h_align": "trailing", "margins": [10, 0, 0, 0], "text": "Maior" },
          { "class": "Layout", "name": "lyQualityTicks", "align": "client", "children": [
            { "class": "TrackBar", "name": "trkQuality", "align": "top", "height": 16, "min": 0, "max": 10, "frequency": 1, "solid_thumb": true, "thumb_size": 14, "track_size": 4, "on_change": "video_quality" },
            { "class": "Label", "name": "lblQualityTick0", "style": "s_tick", "top": 18, "width": 10, "height": 14, "hit_test": false, "text": "0" },
            { "class": "Label", "name": "lblQualityTick1", "style": "s_tick", "top": 18, "width": 10, "height": 14, "hit_test": false, "text": "1" },
            { "class": "Label", "name": "lblQualityTick2", "style": "s_tick", "top": 18, "width": 10, "height": 14, "hit_test": false, "text": "2" },
            { "class": "Label", "name": "lblQualityTick3", "style": "s_tick", "top": 18, "width": 10, "height": 14, "hit_test": false, "text": "3" },
            { "class": "Label", "name": "lblQualityTick4", "style": "s_tick", "top": 18, "width": 10, "height": 14, "hit_test": false, "text": "4" },
            { "class": "Label", "name": "lblQualityTick5", "style": "s_tick", "top": 18, "width": 10, "height": 14, "hit_test": false, "text": "5" },
            { "class": "Label", "name": "lblQualityTick6", "style": "s_tick", "top": 18, "width": 10, "height": 14, "hit_test": false, "text": "6" },
            { "class": "Label", "name": "lblQualityTick7", "style": "s_tick", "top": 18, "width": 10, "height": 14, "hit_test": false, "text": "7" },
            { "class": "Label", "name": "lblQualityTick8", "style": "s_tick", "top": 18, "width": 10, "height": 14, "hit_test": false, "text": "8" },
            { "class": "Label", "name": "lblQualityTick9", "style": "s_tick", "top": 18, "width": 10, "height": 14, "hit_test": false, "text": "9" },
            { "class": "Label", "name": "lblQualityTick10", "style": "s_tick", "top": 18, "width": 10, "height": 14, "hit_test": false, "text": "10" }
          ] }
        ] },
      { "class": "Label", "name": "lblQualityHint", "style": "s_hint", "align": "top", "auto_size": true, "wrap": true, "v_align": "leading", "margins": [0, 6, 0, 0], "text": "Padrão — balanceado entre tamanho do arquivo e qualidade visual." },
      { "class": "Layout", "name": "lylblQualitySvtFloor", "align": "top", "auto_size": true, "margins": [0, 6, 0, 0], "children": [
          { "class": "Rectangle", "name": "barlblQualitySvtFloor", "align": "most_left", "width": 2, "fill": "amber", "stroke_width": 0, "hit_test": false },
          { "class": "Label", "name": "lblQualitySvtFloor", "style": "s_warn", "align": "top", "auto_size": true, "wrap": true, "v_align": "leading", "margins": [10, 0, 0, 0], "text": "Com AV1 (CPU), os níveis 0 a 3 gravam igual: o encoder já está no mínimo de qualidade dele, e o arquivo não fica menor." }
        ] },
      { "class": "Rectangle", "name": "lnRule2", "style": "sep", "align": "top", "height": 1, "margins": [0, 10, 0, 0] },
      { "class": "Label", "name": "lblVideoTest", "style": "s_label", "align": "top", "auto_size": true, "wrap": true, "v_align": "leading", "margins": [0, 10, 0, 0], "text": "Comparar os níveis de qualidade" },
      { "class": "Label", "name": "lblVideoTestHint", "style": "s_hint", "align": "top", "auto_size": true, "wrap": true, "v_align": "leading", "margins": [0, 6, 0, 0], "text": "Grava 5 segundos da tela e mostra quanto cada nível ocuparia e como a imagem fica. O tamanho depende do que muda na tela: durante o teste, role uma página ou deixe um vídeo tocando." },
      { "class": "Layout", "name": "lyVideoTest", "align": "top", "auto_size": true, "margins": [0, 0, 0, 0], "children": [
          { "class": "Layout", "name": "lyVtButtons", "align": "top", "height": 33, "margins": [0, 8, 0, 0], "children": [
              { "class": "Button", "name": "btnVtRun", "style": "s", "align": "left", "width": 130, "height": 33, "margins": [0, 0, 8, 0], "text": "Testar os níveis", "on_click": "video_test_run" },
              { "class": "Button", "name": "btnVtCancel", "style": "s", "align": "left", "width": 90, "height": 33, "margins": [0, 0, 8, 0], "visible": false, "text": "Cancelar", "on_click": "video_test_cancel" }
            ] },
          { "class": "Label", "name": "lblVtStatus", "style": "s_hint", "align": "top", "auto_size": true, "wrap": true, "v_align": "leading", "margins": [0, 6, 0, 0], "visible": false, "text": "Preparando…" },
          { "class": "ProgressBar", "name": "prgVt", "align": "top", "height": 4, "margins": [0, 6, 0, 0], "visible": false },
          { "class": "Layout", "name": "lyVtResult", "align": "top", "auto_size": true, "margins": [0, 0, 0, 0], "visible": false, "children": [
              { "class": "Label", "name": "lblVtSample", "style": "s_hint", "align": "top", "auto_size": true, "wrap": true, "v_align": "leading", "margins": [0, 10, 0, 0], "text": "" },
              { "class": "Layout", "name": "lyVtLevels", "align": "top", "auto_size": true, "margins": [0, 6, 0, 0] },
              { "class": "Label", "name": "lblVtPickHint", "style": "s_hint", "align": "top", "auto_size": true, "wrap": true, "v_align": "leading", "margins": [0, 12, 0, 0], "text": "Escolha o nível de cada lado no seletor sobre a imagem, ou clique num nível da lista (Shift ou botão direito: lado B). As setas ↑ ↓ trocam o nível A; com Shift, o B. Espaço toca e pausa; ← → andam um quadro." },
              { "class": "Layout", "name": "lyVtTools", "align": "top", "height": 31, "margins": [0, 16, 0, 0], "children": [
                  { "class": "Button", "name": "btnVtSwap", "style": "s", "font_size": 12, "align": "left", "width": 100, "height": 31, "text": "Trocar A ↔ B", "on_click": "video_test_swap" },
                  { "class": "Button", "name": "btnVtZoom300", "style": "s", "font_size": 12, "align": "right", "width": 50, "height": 31, "margins": [6, 0, 0, 0], "tag": 3, "text": "300%", "on_click": "video_test_zoom" },
                  { "class": "Button", "name": "btnVtZoom200", "style": "s", "font_size": 12, "align": "right", "width": 50, "height": 31, "margins": [6, 0, 0, 0], "tag": 2, "text": "200%", "on_click": "video_test_zoom" },
                  { "class": "Button", "name": "btnVtZoom100", "style": "s", "font_size": 12, "align": "right", "width": 50, "height": 31, "margins": [6, 0, 0, 0], "tag": 1, "text": "100%", "on_click": "video_test_zoom" },
                  { "class": "Button", "name": "btnVtZoomFit", "style": "s", "font_size": 12, "align": "right", "width": 60, "height": 31, "margins": [6, 0, 0, 0], "tag": 0, "text": "Ajustar", "on_click": "video_test_zoom" }
                ] },
              { "class": "Panel", "name": "pnlVtStage", "style": "s_stage", "align": "top", "height": 200, "margins": [0, 8, 0, 0], "clip_children": true, "on_pointer_down": "video_stage_down", "on_pointer_move": "video_stage_move", "on_pointer_up": "video_stage_up", "children": [
                  { "class": "Image", "name": "imgVtA", "fit": "stretch", "width": 100, "height": 100, "hit_test": false },
                  { "class": "Layout", "name": "lyVtB", "width": 100, "height": 100, "clip_children": true, "hit_test": false, "children": [
                      { "class": "Image", "name": "imgVtB", "fit": "stretch", "width": 100, "height": 100, "hit_test": false }
                    ] },
                  { "class": "Rectangle", "name": "shpVtSplit", "fill": "#FFFFFF", "stroke_width": 0, "width": 2, "height": 100, "hit_test": false },
                  { "class": "Circle", "name": "cirVtKnob", "fill": "#FFFFFF", "stroke_width": 0, "width": 26, "height": 26, "hit_test": false },
                  { "class": "Label", "name": "lblVtKnob", "style": "s_knob", "width": 26, "height": 26, "h_align": "center", "hit_test": false, "text": "‹›" },
                  { "class": "Panel", "name": "pnlVtTagA", "style": "s_tag", "top": 9, "width": 70, "height": 24, "hit_test": false, "children": [
                      { "class": "Label", "name": "lblVtTagA", "style": "s_tag_text", "align": "client", "margins": [9, 0, 0, 0], "hit_test": false, "text": "" },
                      { "class": "Rectangle", "name": "shpVtTagA", "fill": "green", "stroke_width": 0, "width": 3, "height": 24, "hit_test": false }
                    ] },
                  { "class": "Panel", "name": "pnlVtTagB", "style": "s_tag", "top": 9, "width": 70, "height": 24, "hit_test": false, "children": [
                      { "class": "Label", "name": "lblVtTagB", "style": "s_tag_text", "align": "client", "margins": [9, 0, 0, 0], "hit_test": false, "text": "" },
                      { "class": "Rectangle", "name": "shpVtTagB", "fill": "blue", "stroke_width": 0, "width": 3, "height": 24, "hit_test": false }
                    ] }
                ] },
              { "class": "Label", "name": "lblVtDragHint", "style": "s_hint", "align": "top", "auto_size": true, "wrap": true, "v_align": "leading", "margins": [0, 6, 0, 0], "text": "Arraste o divisor pra comparar A (esquerda) com B (direita), tocando ou parado. Os defeitos de compressão só aparecem no tamanho real: use o zoom de 100% ou mais e arraste a imagem pra andar por ela." },
              { "class": "Layout", "name": "lyVtUse", "align": "top", "height": 33, "margins": [0, 14, 0, 0], "children": [
                  { "class": "Button", "name": "btnVtUse", "style": "s_primary", "align": "left", "width": 200, "height": 33, "margins": [0, 0, 8, 0], "text": "Usar o nível {{n}} nas gravações", "on_click": "video_test_use" }
                ] }
            ] }
        ] },
      { "class": "Rectangle", "name": "lnRule3", "style": "sep", "align": "top", "height": 1, "margins": [0, 10, 0, 0] },
      { "class": "Label", "name": "lblFps", "style": "s_label", "align": "top", "auto_size": true, "wrap": true, "v_align": "leading", "margins": [0, 10, 0, 0], "text": "Taxa de quadros da gravação" },
      { "class": "Layout", "name": "lyFps", "align": "top", "height": 32, "margins": [0, 10, 0, 0], "children": [
          { "class": "Label", "name": "lblFpsLow", "style": "s_end", "align": "left", "width": 70, "margins": [0, 0, 10, 0], "text": "Menos fluido" },
          { "class": "Label", "name": "lblFpsHigh", "style": "s_end", "align": "right", "width": 70, "h_align": "trailing", "margins": [10, 0, 0, 0], "text": "Mais fluido" },
          { "class": "Layout", "name": "lyFpsTicks", "align": "client", "children": [
            { "class": "TrackBar", "name": "trkFps", "align": "top", "height": 16, "min": 0, "max": 4, "frequency": 1, "solid_thumb": true, "thumb_size": 14, "track_size": 4, "on_change": "video_fps" }
          ] }
        ] },
      { "class": "Label", "name": "lblFpsHint", "style": "s_hint", "align": "top", "auto_size": true, "wrap": true, "v_align": "leading", "margins": [0, 6, 0, 0], "text": "{{fps}} fps — boa fluidez, ótimo para uso geral." },
      { "class": "Rectangle", "name": "lnRule4", "style": "sep", "align": "top", "height": 1, "margins": [0, 10, 0, 0] },
      { "class": "Label", "name": "lblKeyframe", "style": "s_label", "align": "top", "auto_size": true, "wrap": true, "v_align": "leading", "margins": [0, 10, 0, 0], "text": "Intervalo de keyframe" },
      { "class": "Layout", "name": "lyKeyframe", "align": "top", "height": 32, "margins": [0, 10, 0, 0], "children": [
          { "class": "Label", "name": "lblKeyframeLow", "style": "s_end", "align": "left", "width": 70, "margins": [0, 0, 10, 0], "text": "Corte exato" },
          { "class": "Label", "name": "lblKeyframeHigh", "style": "s_end", "align": "right", "width": 70, "h_align": "trailing", "margins": [10, 0, 0, 0], "text": "Arquivo menor" },
          { "class": "Layout", "name": "lyKeyframeTicks", "align": "client", "children": [
            { "class": "TrackBar", "name": "trkKeyframe", "align": "top", "height": 16, "min": 0, "max": 9, "frequency": 1, "solid_thumb": true, "thumb_size": 14, "track_size": 4, "on_change": "video_keyframe" },
            { "class": "Label", "name": "lblKeyframeTick1", "style": "s_tick", "top": 18, "width": 10, "height": 14, "hit_test": false, "text": "1s" },
            { "class": "Label", "name": "lblKeyframeTick2", "style": "s_tick", "top": 18, "width": 10, "height": 14, "hit_test": false, "text": "2s" },
            { "class": "Label", "name": "lblKeyframeTick3", "style": "s_tick", "top": 18, "width": 10, "height": 14, "hit_test": false, "text": "3s" },
            { "class": "Label", "name": "lblKeyframeTick4", "style": "s_tick", "top": 18, "width": 10, "height": 14, "hit_test": false, "text": "4s" },
            { "class": "Label", "name": "lblKeyframeTick5", "style": "s_tick", "top": 18, "width": 10, "height": 14, "hit_test": false, "text": "5s" },
            { "class": "Label", "name": "lblKeyframeTick6", "style": "s_tick", "top": 18, "width": 10, "height": 14, "hit_test": false, "text": "6s" },
            { "class": "Label", "name": "lblKeyframeTick7", "style": "s_tick", "top": 18, "width": 10, "height": 14, "hit_test": false, "text": "7s" },
            { "class": "Label", "name": "lblKeyframeTick8", "style": "s_tick", "top": 18, "width": 10, "height": 14, "hit_test": false, "text": "8s" },
            { "class": "Label", "name": "lblKeyframeTick9", "style": "s_tick", "top": 18, "width": 10, "height": 14, "hit_test": false, "text": "9s" },
            { "class": "Label", "name": "lblKeyframeTick10", "style": "s_tick", "top": 18, "width": 10, "height": 14, "hit_test": false, "text": "10s" }
          ] }
        ] },
      { "class": "Label", "name": "lblKeyframeHint", "style": "s_hint", "align": "top", "auto_size": true, "wrap": true, "v_align": "leading", "margins": [0, 6, 0, 0], "text": "A cada {{sec}} segundos — bom equilíbrio entre pontos de corte e tamanho. (Recomendado)" }
    ]
  }
}
