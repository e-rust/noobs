        "margins": [0, 10, 0, 0],
        "auto_size": true,
        "style": "web"
      },
      {
        "class": "Label",
        "name": "lblCloseToTrayHint",
        "text": "Permite ao NoOBS usar o ícone na bandeja do sistema. Com esta opção ativa, o botão X da janela manda pra bandeja em vez de encerrar — clique no ícone pra reabrir, ou use o menu do ícone pra fechar de verdade.",
        "v_align": "leading",
        "wrap": true,
        "height": 30,
        "align": "top",
        "margins": [0, 6, 0, 0],
        "auto_size": true,
        "style": "s_hint"
      },
      {
        "class": "Rectangle",
        "name": "lnRuleHibernate",
        "height": 1,
        "align": "top",
        "margins": [0, 10, 0, 0],
        "style": "sep"
      },
      {
        "class": "CheckBox",
        "name": "chkHibernate",
        "text": "Liberar memória após 1 minuto na bandeja",
        "box_size": 16,
        "on_change": "general_hibernate",
        "height": 16,
        "align": "top",
        "margins": [0, 10, 0, 0],
        "auto_size": true,
        "style": "web"
      },
      {
        "class": "Label",
        "name": "lblHibernateHint",
