        "wrap": true,
        "height": 30,
        "align": "top",
        "margins": [0, 6, 0, 0],
        "auto_size": true,
        "style": "s_hint"
      },
      {
        "class": "Rectangle",
        "name": "lnRule6",
        "height": 1,
        "align": "top",
