        "align": "top",
        "margins": [0, 10, 0, 0],
        "auto_size": true,
        "style": "web"
      },
      {
        "class": "Label",
        "name": "lblRunAsAdminHint",
        "text": "Necessário para o atalho funcionar com aplicações que rodam como administrador (ex.: o Gerenciador de Tarefas). O Windows pede confirmação toda vez que o NoOBS abre; se você recusar, a opção é desligada e o NoOBS abre normalmente. Vale a partir da próxima vez que o NoOBS abrir.",
        "v_align": "leading",
        "wrap": true,
        "height": 44,
        "align": "top",
        "margins": [0, 6, 0, 0],
        "auto_size": true,
        "style": "s_hint"
      },
      {
        "class": "Label",
        "name": "lblRunAsAdminState",
        "text": "Agora: rodando sem administrador.",
        "v_align": "leading",
        "wrap": true,
        "height": 16,
        "align": "top",
        "margins": [0, 6, 0, 0],
        "auto_size": true,
        "style": "s_hint"
      },
      {
        "class": "Rectangle",
        "name": "lnRule5",
        "height": 1,
        "align": "top",
        "margins": [0, 10, 0, 0],
