{
  "aylis": 1,
  "root": {
    "class": "Form",
    "name": "fraSourceRow",
    "caption": "Tela principal: linha de dispositivo de áudio",
    "width": 376,
    "height": 45,
    "align": "top",
    "fill": "transparent",
    "children": [
      {
        "class": "Panel",
        "name": "pnlRow",
        "hover_fill": "row_hover",
        "align": "client",
        "padding": [10, 8],
        "cursor": "pointer",
        "style": "row",
        "children": [
          {
            "class": "Rectangle",
            "name": "shpStripe",
            "left": -12,
            "width": 3,
            "height": 45,
            "hit_test": false,
            "style": "stripe"
          },
          {
            "class": "Switch",
            "name": "swOn",
            "width": 36,
            "align": "right",
            "margins": [10, 4, 0, 4]
          },
          {
            "class": "Layout",
            "name": "lyBody",
            "align": "client",
            "children": [
              {
                "class": "Layout",
                "name": "lyLine",
                "height": 17,
                "align": "top",
                "children": [
                  {
                    "class": "Circle",
                    "name": "dotDefault",
                    "fill": "device_default",
                    "stroke_width": 0,
                    "width": 7,
                    "align": "left",
                    "margins": [0, 5, 6, 5],
                    "visible": false,
                    "hint": "Dispositivo padrão do sistema"
                  },
                  {
                    "class": "Icon",
                    "name": "icoBtMic",
                    "icon": "warning",
                    "color": "amber",
                    "width": 13,
                    "align": "left",
                    "margins": [0, 2, 6, 2],
                    "visible": false,
                    "hit_test": true,
                    "hint": "Atenção: enquanto este microfone Bluetooth estiver conectado e o NoOBS aberto (mesmo sem marcar pra gravar — os medidores de nível já abrem acesso ao mic), o Windows mantém o fone no perfil HFP. A qualidade do áudio do dispositivo cai pra mono 8 ou 16 kHz e o volume costuma ir pro máximo. Limitação do Bluetooth Classic — desmarcar aqui não resolve. Pra recuperar HD, desative ou desconecte o dispositivo no Windows, ou use um microfone USB separado."
                  },
                  {
                    "class": "Icon",
                    "name": "icoBtSpeaker",
                    "icon": "warning",
                    "color": "amber",
                    "width": 13,
                    "align": "left",
                    "margins": [0, 2, 6, 2],
                    "visible": false,
                    "hit_test": true,
                    "hint": "Atenção: alto-falante Bluetooth. Quando qualquer app no Windows acessa um microfone Bluetooth (incluindo os medidores de nível do NoOBS), este dispositivo cai pra qualidade telefônica (mono 8 ou 16 kHz) e volume máximo automaticamente. Limitação do Bluetooth Classic — pra HD, desative o microfone Bluetooth no Windows, ou use BT LE Audio (hardware mais novo + Windows 11)."
                  },
                  {
                    "class": "Label",
                    "name": "lblName",
                    "align": "client",
                    "style": "row"
                  }
                ]
              },
              {
                "class": "LevelMeter",
                "name": "mtrLevel",
                "stereo": true,
                "gradient": true,
                "show_peak": false,
                "mid": 0.6,
                "high": 0.75,
                "smoothing": 90,
                "height": 7,
                "align": "top",
                "margins": [0, 4, 0, 0]
              }
            ]
          }
        ]
      }
    ]
  }
}
