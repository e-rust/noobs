          { "class": "Button", "name": "btnIcon", "style": "pl_vicon", "text": "", "icon": "pl-expand", "icon_size": 18, "align": "left", "width": 18, "margins": [0, 0, 10, 0], "hit_test": false },
          { "class": "Label", "name": "lblLabel", "style": "pl_vlabel", "align": "client", "trimming": "character", "hit_test": false, "text": "" }
