  "scroll": {
    "wheel_step": 100.0,
    "smooth": true,
    "smooth_ms": 160.0
  },
  "output": {
    "dir": "runtime",
    "name": "NoOBS"
  },
  "locale": "pt-BR",
  "publish": {
    "app_name": "NoOBS",
    "version": "0.0.10-beta",
    "icon": "assets/images/icon.png",
    "publisher": "e-rust",
    "windows": {
      "installer": "nsis",
      "files": [
        "runtime/*.dll"
      ],
      "install_dir": "{localappdata}\\NoOBS",
      "exe_dir": "bin",
      "autostart": "on",
      "autostart_args": "/autostart",
      "desktop_shortcut": "off",
      "run_as_admin": "off",
      "close_running": true,
      "run_after_install": true,
      "data_dir": "{localappdata}\\NoOBS"
    }
  },
  "render": {
    "windows": "d2d",
    "linux": "auto",
    "macos": "auto",
    "android": "auto",
    "ios": "cpu"
  },
  "text": {
    "windows": "native",
    "linux": "native",
    "macos": "native",
    "android": "native",
    "ios": "native",
    "web": "native"
  },
  "present": "composition",
  "platforms": [
    "windows"
  ]
}
